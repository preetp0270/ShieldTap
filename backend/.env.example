# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (create free cluster at https://cloud.mongodb.com)
# Network Access → Add IP 0.0.0.0/0 for testing
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shieldtap?retryWrites=true&w=majority

# JWT – generate a long random string
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=5d

# Cloudinary (https://cloudinary.com → Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Email (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ShieldTap <noreply@shieldtap.app>"

# Frontend / Android origin (for CORS)
CORS_ORIGIN=*
