# MongoDB Atlas connection string
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/shieldtap?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/shieldtap?retryWrites=true&w=majority

# Long random string for signing JWTs (min 32 chars recommended)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=5d

# Cloudinary (from dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional
PORT=5000
CORS_ORIGIN=*
NODE_ENV=development
